{
  "manifest_id": "chapter_12_predraft_pilot",
  "scope": "chapter_12_predraft_hard_stop_1",
  "deliverables": [
    {
      "id": "D01",
      "description": "Reconstruct and verify Chapter 12 source evidence before planning",
      "requires": [],
      "checks": [
        {
          "type": "file_nonempty",
          "path": "research/evidence/chapter_12.json"
        },
        {
          "type": "evidence",
          "chapter": "12"
        }
      ]
    },
    {
      "id": "D02",
      "description": "Classify Chapter 12 source facts, unresolved claims, and adaptation decisions",
      "requires": [
        "D01"
      ],
      "checks": [
        {
          "type": "file_nonempty",
          "path": "research/claims/chapter_12.json"
        },
        {
          "type": "claim",
          "chapter": "12"
        }
      ]
    },
    {
      "id": "D03",
      "description": "Prepare the evidence-bound Chapter 12 Brief and stop at Author Hard Stop 1",
      "requires": [
        "D02"
      ],
      "checks": [
        {
          "type": "file_nonempty",
          "path": "briefs/chapter_12_brief.md"
        }
      ]
    }
  ]
}
